
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin untuk mengakses pengaturan Do Not Disturb -->
    <uses-permission
        android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Izin internet untuk mengambil jadwal salat -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Izin menerima notifikasi sistem setelah perangkat menyala -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Izin alarm tepat waktu pada Android 12 ke atas -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:label="Salat DND"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Halaman utama aplikasi -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Receiver untuk mengaktifkan dan mematikan DND -->
        <receiver
            android:name=".PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Receiver ketika perangkat selesai dinyalakan -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
